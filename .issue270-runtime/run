#!/bin/bash
set -eu
KICAD_ROOT=/home/hatch/workspace/projects/he-piantor-42/.issue194-runtime/kicad
GEOMETRY_SITE=/home/hatch/workspace/projects/he-piantor-42/.issue194-runtime/geometry/lib/python3.12/site-packages
ROUTER_PYTHON=/home/hatch/workspace/projects/he-piantor-42/.issue194-runtime/venv/bin/python3
KRT_HOME=/home/hatch/workspace/projects/he-piantor-42/.issue194-runtime/KiCadRoutingTools
CAD_PYTHON=/home/hatch/workspace/tools/cad-venv/bin/python
TASK_RUNTIME=/home/hatch/workspace/projects/he-piantor-mainoutline/.issue270-runtime
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$KICAD_ROOT/usr/lib/python3/dist-packages:$GEOMETRY_SITE"
export LD_LIBRARY_PATH="$KICAD_ROOT/usr/lib/x86_64-linux-gnu:$KICAD_ROOT/usr/lib/kicad"
export KICAD_STOCK_DATA_HOME="$KICAD_ROOT/usr/share/kicad"
export KICAD_CLI="$KICAD_ROOT/usr/bin/kicad-cli"
export TMPDIR="$TASK_RUNTIME/tmp"
export XDG_CONFIG_HOME="$TASK_RUNTIME/config" XDG_CACHE_HOME="$TASK_RUNTIME/cache" XDG_DATA_HOME="$TASK_RUNTIME/data" XDG_STATE_HOME="$TASK_RUNTIME/state"
export PATH="$KICAD_ROOT/usr/bin:$PATH"
export ROUTER_PYTHON KRT_HOME CAD_PYTHON GEOMETRY_SITE
unset DISPLAY WAYLAND_DISPLAY
exec "$@"
