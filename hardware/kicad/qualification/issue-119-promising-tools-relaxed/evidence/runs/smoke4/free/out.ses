(session corrected
  (base_design corrected)
  (placement
    (resolution um 10)
    (component Probe:U2
      (place U2 0 0 front 0)
    )
    (component Probe:U1
      (place U1 0 0 front 0)
    )
    (component Probe:U3
      (place U3 0 0 front 0)
    )
    (component Probe:H1
      (place H1 0 0 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version "9.0.9-9.0.9~ubuntu24.04.1")
    )
    (library_out 
      (padstack "Via[0-3]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle In1.Cu 6000 0 0)
        )
        (shape
          (circle In2.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net N
        (wire
          (path F.Cu 1270
            160000 -100000
            100000 -100000
          )
        )
        (wire
          (path F.Cu 2000
            100000 -100000
            100000 -120000
          )
          (type protect)
        )
      )
    )
  )
)