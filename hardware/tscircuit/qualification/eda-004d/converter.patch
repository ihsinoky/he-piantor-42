+
+function sourceElectricalType(port: SourcePort): SymbolPin["pinElectricalType"] {
+  const types: SymbolPin["pinElectricalType"][] = []
+  if (port.is_input) types.push("input")
+  if (port.is_output) types.push("output")
+  if (port.is_bidirectional) types.push("bidirectional")
+  if (port.is_passive) types.push("passive")
+  if (port.provides_power || port.provides_ground) types.push("power_out")
+  if (port.requires_power || port.requires_ground) types.push("power_in")
+  if (port.do_not_connect) types.push("no_connect")
+  if (types.length !== 1) {
+    throw new Error(`Missing or conflicting electrical type: ${port.source_port_id}`)
+  }
+  const special = [port.is_using_tri_state, port.is_using_open_collector,
+    port.is_using_open_emitter].filter(Boolean).length
+  if (special > 1 || (special && types[0] !== "output")) {
+    throw new Error(`Conflicting output mode: ${port.source_port_id}`)
+  }
+  if (port.is_using_tri_state) return "tri_state"
+  if (port.is_using_open_collector) return "open_collector"
+  if (port.is_using_open_emitter) return "open_emitter"
+  return types[0]
+}
