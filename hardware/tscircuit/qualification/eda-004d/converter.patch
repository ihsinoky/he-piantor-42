@@ -89,0 +90,13 @@
+// Definitions and instances use this shared function. Component identity avoids
+// assuming equal artwork names imply equal pin names or electrical semantics.
+export function getLibraryId(
+  sourceComp: SourceComponentBase,
+  schematicComp: SchematicComponent,
+  cadComponent?: CadComponent | null,
+  schematicSymbolName?: string,
+): string {
+  const identity = Array.from(sourceComp.source_component_id)
+    .map((character) => character.codePointAt(0)!.toString(16)).join("_")
+  return `${getBaseLibraryId(sourceComp, schematicComp, cadComponent, schematicSymbolName)}_${identity}`
+}
