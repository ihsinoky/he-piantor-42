for l,a,c in route:
 assert calc(l,a,c,True,True)>0
 t=p.PCB_TRACK(b)
 t.SetStart(p.VECTOR2I(*map(iu,a)))
 t.SetEnd(p.VECTOR2I(*map(iu,c)))
 t.SetWidth(iu(.10))
 t.SetLayer(LC[l])
 t.SetNet(net)
 b.Add(t)
 add.append(dict(net='LED_DRV',pad=False,name='new',shapes={l:LineString([a,c]).buffer(.05)}))
v=p.PCB_VIA(b)
v.SetViaType(p.VIATYPE_THROUGH)
v.SetLayerPair(p.F_Cu,p.B_Cu)
