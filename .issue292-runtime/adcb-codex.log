  legs[5]=NET,'I2',.1,r
  break
extra=vs+sum([segs(n,l,li,w) for n,l,w,li in legs],[])
for item in extra:check(item,extra,ids)
for n in [NET,'BTN','PAD_DR']:
 for phase,args in [('before',()),('after',(extra,ids))]:
  print(n,phase,[[m['name'] for m in c if m['pad']] for c in components(n,*args)])
for x,y in [xy1,xy2,xy3]:
 items=[]
 for m in MODEL:
  if m['via']:
   t=m['obj'];d=math.dist(m['ends'][0],(x,y))
   items.append((d-.15-mm(t.GetDrillValue())/2,m['net'],m['ends'][0]))
 print('hole gap',x,y,min(items))
(root/'geometry.json').write_text(json.dumps(legs))
for m in [MODEL[i] for i in ids]:b.Remove(m['obj'])
new=[]
for n,l,w,path in legs:
 for a,z in zip(path,path[1:]):
  t=p.PCB_TRACK(b)
  t.SetStart(p.VECTOR2I(*map(iu,a))); t.SetEnd(p.VECTOR2I(*map(iu,z)))
  t.SetWidth(iu(w));t.SetLayer(LC[l]);t.SetNet(b.FindNet(n));b.Add(t)
  new.append(t.m_Uuid.AsString())
for x,y in [xy1,xy2,xy3]:
 v=p.PCB_VIA(b)
 v.SetViaType(p.VIATYPE_THROUGH)
 v.SetLayerPair(p.F_Cu,p.B_Cu)
 v.SetPosition(p.VECTOR2I(iu(x),iu(y))); v.SetWidth(iu(.6)); v.SetDrill(iu(.3))
 v.SetNet(b.FindNet(NET)); b.Add(v)
 new.append(v.m_Uuid.AsString())
(root/'new.json').write_text(json.dumps(new))
def write(zlayer):
 board=b
 for z in board.Zones():
  if z.GetZoneName()=='MODULE_FIELD_FINE' and zlayer:
   ls=p.LSET()
   for l in LC.values():ls.AddLayer(l)
   z.SetLayerSet(ls)
 tag='rules' if zlayer else 'orig'
 p.SaveBoard(str(root/f'{tag}.kicad_pcb'),board)
write(False);write(True)
