/bin/bash -lc "cat > /tmp/adcb_edit.py <<'PY'
from led_grid import *
NET='ADC_B'
def addseg(n,l,a,b,w=.1):
 return dict(net=n, shapes={l:LineString([a,b]).buffer(w/2,quad_segs=Q)},name=f'{n} {a} {b}',pad=False,via=False, ends=(a,b),w=w)
def addvia(n,xy):
 return dict(net=n,shapes={l:Point(xy).buffer(.3,quad_segs=Q) for l in LAYS},name=f'{n} via {xy}',pad=False,via=True,ends=(xy,xy),w=.6)
def check(m,extras=[],off=()):
 for l,shape in m['shapes'].items():
  obs=sorted([(shape.distance(other['shapes'][l]),other['name'],other['net']) for other in ALL+extras if m['net']"'!=other['"'net'] and other.get('id') not in off and l in other['shapes']])
  print(m['name'],l,obs[:4], 'edge',OUTLINE.exterior.distance(shape), 'keepout',min(shape.distance(k) for k in KOS[l]) if KOS[l] else None)
def setup(extra=[],off=(),xy=None):
 c=components(NET,extra,off)
 if not any(m['name']=='U1.46' for m in c[0]):c.reverse()
 ss=[seedmasks(li) for li in c]
 bd,v=blockmasks(NET,RAD,extra,off,tol=-1e-7)
 if xy:v[ind(xy)]=True
 rr,ll=reachgraph(bd,v,ss)
 print('reach size',[[int(np.count_nonzero(a)) for a in r] for r in rr])
 return c,ss,bd,v,rr,ll
if __name__=='__main__':
 for i in [2871,1304,3005,1318,2873,2874]:
  m=MODEL[i];print(i,m['net'],m['ends'],m['w'])
 c,ss,bd,v,rr,ll=setup()
 for xy in [(73.05,120.15),(73.3,120.15),(73.4,122.1),(73.1,121.25)]:
  j,i=ind(xy); print(xy,[(bd[z,j,i],rr[0][z,j,i],rr[1][z,j,i]) for z in range(3)])
  check(addvia(NET,xy))
 for net,xy,ids,path in [
  ('BTN',(73.05,120.15),[2871],[(72.85,119.35),(72.85,119.45),(72.6,119.70),(72.6,120.6),(72.85,120.85),(72.85,121.75)]),
  ('RESET_N',(73.3,120.15),[1304],[(73.5,119.4),(73.5,119.45),(73.75,119.70),(73.75,120.6),(73.5,120.85),(73.5,121.4)]),
 ]:
  aa=[addseg(net,'F',a,b,.05) for a,b in zip(path,path[1:])]
  vv=addvia(NET,xy)
  for m in aa+[vv]: check(m,aa+[vv],ids)
  c,ss,bd,v,rr,ll=setup(aa,ids,xy)
  if np.intersect1d(ll[0],ll[1]).size:
   path=findpath(bd,v,ss[0]&rr[1],ss[1]);print(compact(path))
