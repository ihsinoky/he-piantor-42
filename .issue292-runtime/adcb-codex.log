v.SetWidth(iu(.60))
v.SetDrill(iu(.30))
v.SetNet(net)
b.Add(v)
add.append(dict(net='LED_DRV',pad=False,name='new via',shapes={l:Point(via_location).buffer(.3) for l in LAYS}))
print('component count after',len(components('LED_DRV',extra=add)))
print('via uuid',v.m_Uuid.AsString())
p.ZONE_FILLER(b).Fill(b.Zones())
print('scratch save',p.SaveBoard(str(base_dir/'candidate.kicad_pcb'), b))
from led_grid import *
route=[('B',(70.5,118),(71.45,117.35)),('B',(71.45,117.35),(71.55,117.35)),('B',(71.55,117.35),(71.6,117.4)),('B',(71.6,117.4),(71.7,117.4)),('B',(71.7,117.4),(72.6,116.5)),('B',(72.6,116.5),(73.2,117.1)),('I2',(73.2,117.1),(72.9,116.8)),('I2',(72.9,116.8),(73.75,115.95)),('I2',(73.75,115.95),(73.75,115.85))]
via_location=(73.2,117.1)
def check(l,copper,do_print=True,force10=False):
 fields=FIELDS
 parts=[(copper,.1,'full')] if force10 else [(copper.intersection(fields),.05,'fine'),(copper.difference(fields),.1,'std')]
 neighbors=[]
 for cu,rule,mode in parts:
  if cu.is_empty:continue
  distances=sorted((cu.distance(m['shapes'][l]),m['name'],m['net'],m.get('ends')) for m in ALL if l in m['shapes'] and m['net']!='LED_DRV')
  d=distances[0]
  neighbors.append((d[0]-rule,mode,d,distances[:3]))
 if do_print:
  for o in neighbors:print('  ',o[1],o[3])
 ed=copper.distance(OUTLINE.boundary) if OUTLINE.covers(copper) else 0
 kd=min((copper.distance(ko) for ko in KOS[l]),default=999)
 if do_print:print('   EDGE',ed,'KO',kd)
 return min([o[0] for o in neighbors]+[ed-.5,kd])
def calc(l,a,c,pr=True,force10=False):
 if pr:print(l,a,c)
 return check(l,LineString([a,c]).buffer(.05/math.cos(math.pi/(4*Q)),quad_segs=Q),pr,force10)
if __name__=='__main__':
 for l,a,c in route: print('   MARGIN',calc(l,a,c))
 cu=Point(via_location).buffer(.3/math.cos(math.pi/(4*Q)),quad_segs=Q)
 for l in LAYS:
  print('VIA',l,check(l,cu,True,True))
 for m in ALL:
  if m['via']:
   a=m['ends'][0]; ds=Point(a).distance(Point(via_location))
   if ds<1.1:
    print('near via',m['net'],a,ds,'drill',mm(m['obj'].GetDrillValue()),'hole gap',ds-.15-mm(m['obj'].GetDrillValue())/2)
  if m['pad'] and any(s.distance(cu)<.3 for s in m['shapes'].values()):
   print('near pad',m['net'],m['name'],{l:s.distance(cu) for l,s in m['shapes'].items()})
 print('old chain')
 for i in (3123,3124):
  m=MODEL[i]; print(i,calc('I2',*m['ends']))

