   if ds<1.1:
    print('near via',m['net'],a,ds,'drill',mm(m['obj'].GetDrillValue()),'hole gap',ds-.15-mm(m['obj'].GetDrillValue())/2)
  if m['pad'] and any(s.distance(cu)<.3 for s in m['shapes'].values()):
   print('near pad',m['net'],m['name'],{l:s.distance(cu) for l,s in m['shapes'].items()})
 print('old chain')
 for i in (3123,3124):
  m=MODEL[i]; print(i,calc('I2',*m['ends']))
